---
import { ClientRouter } from "astro:transitions";
import { ArrowUpRight, Moon, Sun, Terminal } from "@lucide/astro";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "围绕 C#、WinForms、SQL Server 与 MES、PLC、OPC 的中文技术笔记",
} = Astro.props;
const siteName = "工控笔记";
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · 工业软件开发博客`;
const nav = [
  { href: "/", label: "首页" },
  { href: "/posts/", label: "技术文章" },
  { href: "/projects/", label: "项目展示" },
  { href: "/about/", label: "关于我" },
];
const current = nav.find(({ href }) => href !== "/" && Astro.url.pathname.startsWith(href))
  ?? (Astro.url.pathname === "/" ? nav[0] : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    {Astro.url.pathname !== "/404" && Astro.url.pathname !== "/404/" && (
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Adapted from AstroPaper's pre-paint theme selection.
      (() => {
        let saved;
        try { saved = localStorage.getItem("controls-theme"); } catch {}
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <header class="site-header" transition:name="site-header">
      <div class="frame topbar">
        <a href="/" class="brand">
          <span class="brand-mark"><Terminal size={19} stroke-width={2.25} /></span>
          <span>{siteName}</span>
        </a>
        <nav aria-label="主导航">
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={current?.href === href ? "page" : undefined}>
              {label}
              {current?.href === href && <span class="nav-marker" transition:name="nav-marker" />}
            </a>
          ))}
        </nav>
        <button type="button" class="theme-toggle icon-button" aria-label="切换深色模式" aria-pressed="false">
          <Moon size={18} class="moon" />
          <Sun size={18} class="sun" />
        </button>
      </div>
    </header>
    <main class="frame" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" transition:name="site-footer">
      <div class="frame footer-row">
        <div><span class="footer-brand">{siteName}</span><span class="footer-note">中文工业软件开发博客</span></div>
        <a class="text-link" href="https://github.com/LiuXin2979/liuxin2979.github.io">网站源码 <ArrowUpRight size={15} /></a>
      </div>
    </footer>
    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
